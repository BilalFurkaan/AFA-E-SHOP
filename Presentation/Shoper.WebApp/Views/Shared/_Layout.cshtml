    <style>

        
        .profile-btn:hover {
            background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%) !important;
            color: #fff !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(74,144,226,0.3) !important;
        }
        
        .logout-btn:hover {
            background: linear-gradient(135deg, #c82333 0%, #a71e2a 100%) !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220,53,69,0.4) !important;
        }
        
        .user-name-container {
            transition: all 0.3s ease;
        }
        
        .user-profile-section:hover .user-name-container {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(74,144,226,0.4) !important;
        }
        
        .user-name {
            transition: color 0.3s ease;
        }
        
        /* AFA Shop Logo Hover Effects */
        .logo-container:hover,
        .logo-container-mobile:hover,
        .logo-container-footer:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(74,144,226,0.3) !important;
            border-color: #357ABD;
        }
        
        .logo-container:hover .logo-icon,
        .logo-container-mobile:hover .logo-icon-mobile,
        .logo-container-footer:hover .logo-icon-footer {
            transform: scale(1.1);
            box-shadow: 0 4px 15px rgba(74,144,226,0.5) !important;
        }
        
        .logo-icon,
        .logo-icon-mobile,
        .logo-icon-footer {
            transition: all 0.3s ease;
        }
        
        /* Sepet ve Favori İkonları Hover Efektleri */
        .btn[href=""]:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(255,107,107,0.4) !important;
            border-color: #ff5252 !important;
        }
        
        .btn[href=""]:hover svg {
            transform: scale(1.1);
            color: #ff5252 !important;
        }
        
        .btn[href="/Cart/Index"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(74,144,226,0.4) !important;
            border-color: #357ABD !important;
        }
        
        .btn[href="/Cart/Index"]:hover svg {
            transform: scale(1.1);
            color: #357ABD !important;
        }
        
        .btn svg {
            transition: all 0.3s ease;
        }
        
        .badge {
            transition: all 0.3s ease;
        }
        
        .btn:hover .badge {
            transform: scale(1.1);
        }
        
        /* Login And Register  */
        .nav-item.nav-link[href="/Account/Login"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(74,144,226,0.25) !important;
            border-color: #357ABD !important;
        }
        
        .nav-item.nav-link[href="/Account/Login"]:hover svg {
            transform: scale(1.1);
        }
        
        .nav-item.nav-link[href="/Account/Register"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(74,144,226,0.4) !important;
            background: linear-gradient(135deg, #357ABD 0%, #2C5F9E 100%) !important;
        }
        
        .nav-item.nav-link[href="/Account/Register"]:hover svg {
            transform: scale(1.1);
        }
        
        .search-container .input-group:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(74,144,226,0.25) !important;
            border-color: #4A90E2 !important;
        }
        
        .search-container .input-group:focus-within {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(74,144,226,0.3) !important;
            border-color: #357ABD !important;
        }
        
        .search-btn:hover {
            background: linear-gradient(135deg, #357ABD 0%, #2C5F9E 100%) !important;
            transform: scale(1.05);
        }
        
        .search-btn:hover svg {
            transform: scale(1.1);
        }
        
        .search-container input:focus {
            outline: none;
            box-shadow: none;
        }
        
        .search-container input::placeholder {
            color: #6c757d;
            opacity: 0.8;
        }
        
        /* Categories Hover Effects */
        .categories-container {
            transition: all 0.3s ease;
        }
        
        .categories-container:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(74,144,226,0.2) !important;
        }
        
        .categories-header:hover {
            background: linear-gradient(135deg, #357ABD 0%, #2C5F9E 100%) !important;
        }
        
        .categories-header:hover i {
            transform: rotate(180deg);
        }
        
        .category-item:hover {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%) !important;
            border-left: 3px solid #4A90E2 !important;
            color: #4A90E2 !important;
            transform: translateX(10px);
            box-shadow: 0 4px 15px rgba(74,144,226,0.1);
        }
        
        .category-item:hover svg {
            transform: scale(1.1);
            color: #357ABD !important;
        }
        
        .category-item svg {
            transition: all 0.3s ease;
        }
